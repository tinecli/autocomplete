{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "outDir": "./build",
    "target": "ES2018",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "types": [
      "@withfig/autocomplete-types"
    ],
    "strict": false
  },
  "exclude": [
    "node_modules/"
  ],
  "include": [
    "./src/**/*"
  ]
}