{
  "name": "tine-specs",
  "version": "2.692.3",
  "description": "Completion spec source for tine",
  "schemaVersion": "v7",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "npx @withfig/autocomplete-tools dev",
    "create-spec": "npx @withfig/autocomplete-tools create-spec",
    "build": "npx @withfig/autocomplete-tools compile",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "tsc --noEmit && echo 'All specs passed validation. You are ready to push!'"
  },
  "author": "",
  "license": "ISC",
  "bugs": "https://github.com/tinecli/autocomplete/issues",
  "repository": "https://github.com/tinecli/autocomplete",
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@fig/autocomplete-generators": "^2.4.0",
    "@fig/autocomplete-helpers": "^1.0.7",
    "@withfig/autocomplete-tools": "^2.11.0",
    "@withfig/autocomplete-types": "^1.31.0",
    "semver": "^7.6.3",
    "strip-json-comments": "^5.0.1",
    "typescript": "~7.0.2",
    "yaml": "^2.7.0"
  }
}
